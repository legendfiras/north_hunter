# Connect a Public Vercel Blob store to this project. Vercel provides this automatically.
BLOB_READ_WRITE_TOKEN=

# Server-only admin login. Set all three in Vercel Production; never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public site address used for canonical links, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://north-hunter-taleb.roytech.solutions

# Optional: the content value of Google Search Console's HTML-tag verification.
GOOGLE_SITE_VERIFICATION=

# Only needed locally for the one-time R2 to Blob migration script.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=north-hunter-media
