# Cloudflare R2. Keep credentials server-only; do not use NEXT_PUBLIC_ names.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=north-hunter-media
R2_PUBLIC_BASE_URL=https://media.example.com

# Server-only admin login. Keep all three configured in Vercel.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public site address used for canonical links, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://north-hunter-taleb.roytech.solutions

# Optional: the content value of Google Search Console's HTML-tag verification.
GOOGLE_SITE_VERIFICATION=
